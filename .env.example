# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8015,http://127.0.0.1:8015
APP_PORT=8015
USE_X_FORWARDED_HOST=True
USE_X_FORWARDED_PORT=True
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Database
# Example Postgres URL:
# postgresql://user:password@host:5432/database_name
DATABASE_URL=sqlite:///db.sqlite3

# Queue / async jobs
# Local development and single-container Easypanel can use this localhost Redis.
# docker/run_single_app.sh starts redis-server automatically when REDIS_URL is localhost.
REDIS_URL=redis://127.0.0.1:6379/0

# In docker compose, use:
# REDIS_URL=redis://redis:6379/0

# Leave these empty to reuse REDIS_URL. Only fill them if broker/result backend differ.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=False
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=2

# OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
GUNICORN_TIMEOUT=120

# Brand
BLAST_BRAND_NAME=BLAST INFO & TECH

# Future integrations
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_ACCESS_TOKEN=
